# ==== 比赛数据：官方卡牌数据库 + C++ 引擎，不公开分发 ====
data/

# ==== 官方 starter kit：cg/ 为比赛方提供的引擎与 API，不公开分发 ====
cg/
deck.csv

# ==== 运行产物 / 缓存 ====
__pycache__/
*.py[cod]
.ipynb_checkpoints/
*.egg-info/
.pytest_cache/

# ==== 提交包产物 ====
dist/

# ==== 对局回放 / 日志 ====
replays/
logs/
*.log
*.log.bak
*.tmp

# ==== 排行榜导出 / 临时下载（别再被 `git add -A` 卷进来）====
*.zip
backup.ipync

# ==== 模型权重（训练产物，可用 train_value.py 重建）====
# ⚠️ 必须锚定根目录：写 `models/` 会匹配任意层级，
#    把 framework/models/ 这个代码目录也一起忽略掉。
/models/
*.pt
*.pth
*.onnx

# ==== 凭据：永远不要提交 ====
kaggle.json
access_token
.credentials*
*.pem
.env
epsoide/
episode/

